# YouTube AI Karaoke Backend Environment Configuration
# Optional: YouTube Data API v3 Key for direct search (Fallback to yt-dlp search if omitted)
YOUTUBE_API_KEY=

# Demucs stem separation model (htdemucs_ft for 95%+ high-precision vocal isolation)
DEMUCS_MODEL=htdemucs

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=https://ktv-frontend-xi.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Server host & port
HOST=0.0.0.0
PORT=8000
